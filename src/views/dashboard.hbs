<script src="/js/dashboard.js"></script>

<div class="container mt-4">
  <!-- Cabecera -->
  <div class="row mb-4">
    <div class="col-12 d-flex justify-content-between align-items-center">
      <div class="d-flex align-items-center gap-3">
        <!-- Avatar con botón para cambiar foto -->
        <div class="position-relative">
          <img 
            src="{{user.avatar}}" 
            alt="Foto de perfil" 
            class="rounded-circle shadow-sm" 
            style="width: 60px; height: 60px; object-fit: cover;"
          />
          <button 
            type="button" 
            class="btn btn-sm btn-primary position-absolute bottom-0 end-0 rounded-circle p-1" 
            data-bs-toggle="modal" 
            data-bs-target="#uploadModal"
            title="Cambiar foto"
            style="width: 24px; height: 24px; line-height: 12px; font-size: 10px;"
          >
            📷
          </button>
        </div>

        <h2 class="mb-0">¡Hola, {{user.nombre}}! 👋</h2>
      </div>
      <a href="/login" class="btn btn-outline-secondary btn-sm">Salir</a>
    </div>
  </div>

  <!-- Modal para subir foto de perfil -->
  <div class="modal fade" id="uploadModal" tabindex="-1" aria-labelledby="uploadModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
      <div class="modal-content">
        <div class="modal-header">
          <h5 class="modal-title" id="uploadModalLabel">Actualizar foto de perfil</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>
        <form action="/upload/avatar" method="POST" enctype="multipart/form-data">
        <input type="hidden" name="user_id" value="{{user.id}}">
          <div class="modal-body">
            <div class="mb-3">
              <label for="archivo" class="form-label">Selecciona una imagen (PNG, JPG)</label>
              <input class="form-control" type="file" id="archivo" name="archivo" accept="image/*" required>
            </div>
          </div>
          <div class="modal-footer">
            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
            <button type="submit" class="btn btn-primary">Guardar foto</button>
          </div>
        </form>
      </div>
    </div>
  </div>

  <!-- Tarjeta de Saldo Principal -->
  <div class="row mb-4">
    <div class="col-md-6 offset-md-3">
      <div class="card text-center bg-dark text-white shadow-sm p-3">
        <div class="card-body">
          <h5 class="card-title text-muted text-uppercase">Saldo Disponible</h5>
          <h1 class="display-4 fw-bold my-3">${{user.saldo}}</h1>
          <p class="card-text text-secondary">N° de Cuenta: {{user.numero_cuenta}}</p>
        </div>
      </div>
    </div>
  </div>

  <!-- Botones de Navegación a las 3 Vistas -->
  <div class="row mb-5 text-center">
    <div class="col-md-4 mb-2">
      <a href="/deposit?user_id={{user.id}}" class="btn btn-success btn-lg w-100 py-3 shadow-sm">
        <i class="bi bi-arrow-down-circle me-2"></i> Depositar
      </a>
    </div>
    <div class="col-md-4 mb-2">
      <a href="/transfer?user_id={{user.id}}" class="btn btn-primary btn-lg w-100 py-3 shadow-sm">
        <i class="bi bi-arrow-up-right-circle me-2"></i> Transferir
      </a>
    </div>
    <div class="col-md-4 mb-2">
      <a href="/transactions?user_id={{user.id}}" class="btn btn-secondary btn-lg w-100 py-3 shadow-sm">
        <i class="bi bi-clock-history me-2"></i> Historial
      </a>
    </div>
  </div>

  <!-- Resumen de Últimos Movimientos -->
  <div class="row">
    <div class="col-12">
      <div class="card shadow-sm">
        <div class="card-header bg-white d-flex justify-content-between align-items-center">
          <h5 class="mb-0 fw-bold">Últimos Movimientos</h5>
          <a href="/transacciones" class="btn btn-sm btn-link">Ver todos</a>
        </div>
        <div class="card-body p-0">
          {{#if transacciones.length}}
            <ul class="list-group list-group-flush">
              {{#each transacciones}}
                <li class="list-group-item d-flex justify-content-between align-items-center p-3">
                  <div>
                    <h6 class="mb-0 fw-semibold">{{this.concepto}}</h6>
                    <small class="text-muted">{{this.fecha}}</small>
                  </div>
                  <span class="fs-5 fw-bold {{#if this.esIngreso}}text-success{{else}}text-danger{{/if}}">
                    {{#if this.esIngreso}}+{{else}}-{{/if}}${{this.monto}}
                  </span>
                </li>
              {{/each}}
            </ul>
          {{else}}
            <div class="p-4 text-center text-muted">
              <p class="mb-0">Aún no registras movimientos en tu cuenta.</p>
            </div>
          {{/if}}
        </div>
      </div>
    </div>
  </div>
</div>
