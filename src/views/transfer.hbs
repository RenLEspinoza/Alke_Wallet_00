<div class="container mt-4">
  <div class="row justify-content-center">
    <div class="col-md-6">

      <!-- Botón Volver -->
      <a
        href="/dashboard?user_id={{user.id}}"
        class="btn btn-outline-secondary btn-sm mb-3"
      >
        ← Volver al Dashboard
      </a>

      <div class="card shadow-sm">
        <div class="card-header bg-primary text-white">
          <h4 class="mb-0 fs-5">
            <i class="bi bi-arrow-up-right-circle me-2"></i>
            Transferir a Terceros
          </h4>
        </div>
        <div class="card-body p-4">
          <form id="transferForm">

            <div class="mb-3">
              <label for="receiver_id" class="form-label fw-semibold">N° de
                Cuenta Destino</label>
              <input
                type="text"
                class="form-control"
                id="receiver_account_number"
                name="numeroCuentaDestino"
                placeholder="Ej: 12345678"
                required
              />
            </div>

            <div class="mb-3">
              <label for="amount" class="form-label fw-semibold">Monto a
                transferir</label>
              <div class="input-group">
                <span class="input-group-text">$</span>
                <input
                  type="number"
                  class="form-control"
                  id="amount"
                  name="monto"
                  placeholder="Ej: 15000"
                  min="1"
                  step="0.01"
                  required
                />
              </div>
            </div>

            <div class="mb-3">
              <label for="description" class="form-label fw-semibold">Concepto /
                Comentario (Opcional)</label>
              <input
                type="text"
                class="form-control"
                id="description"
                name="descripcion"
                placeholder="Ej: Pago de arriendo, cena, etc."
              />
            </div>

            <div class="d-grid gap-2 mt-4">
              <button type="submit" class="btn btn-primary btn-lg">
                Confirmar Transferencia
              </button>
            </div>

            <div id="feedbackMessage" class="mt-3" style="display: none;"></div>
          </form>
        </div>
      </div>

    </div>
  </div>
</div>

<script src="/js/transfer.js"></script>